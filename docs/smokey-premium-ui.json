  "sourceRoots": [
    "dashboard/src/features/business",
    "dashboard/src/features/theme"
  ],
  "canonicalMap": "docs/SMOKEY-UI-CONTRACT.md",
  "requiredCapabilities": [
    "Select/Listbox",
    "Date",
    "Form",
    "CRUD",
    "Scrollbar"
  ],
